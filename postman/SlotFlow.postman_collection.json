    {
      "name": "Working hours",
      "description": "Availability is stored as rules, not as pre-generated slots.",
      "item": [
        {
          "name": "Get working hours",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Tenant",
                "value": "{{tenant}}",
                "description": "The workspace. Ignored when a token is sent \u2014 a token carries its own."
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/staff/{{staff_id}}/availability-rules",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "staff",
                "{{staff_id}}",
                "availability-rules"
              ]
            },
            "description": "Wall-clock times in the staff member's own timezone. `weekday` is 0 = Sunday \u2026 6 = Saturday."
          }
        },
        {
          "name": "Replace working hours",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Tenant",
                "value": "{{tenant}}",
                "description": "The workspace. Ignored when a token is sent \u2014 a token carries its own."
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/staff/{{staff_id}}/availability-rules",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "staff",
                "{{staff_id}}",
                "availability-rules"
              ]
            },
            "description": "Send the complete week; it replaces what was there. A replace rather than a merge, so sending the same payload twice leaves the same schedule.\n\nTwo entries on one weekday is how you model a lunch break. An end earlier than the start means an overnight shift, and is handled.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rules\": [\n    {\n      \"weekday\": 2,\n      \"starts_at\": \"09:00\",\n      \"ends_at\": \"13:00\"\n    },\n    {\n      \"weekday\": 2,\n      \"starts_at\": \"14:00\",\n      \"ends_at\": \"18:00\"\n    },\n    {\n      \"weekday\": 4,\n      \"starts_at\": \"11:00\",\n      \"ends_at\": \"19:00\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Book time off",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Tenant",
                "value": "{{tenant}}",
                "description": "The workspace. Ignored when a token is sent \u2014 a token carries its own."
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/staff/{{staff_id}}/time-off",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "staff",
                "{{staff_id}}",
                "time-off"
              ]
            },
            "description": "Absolute instants, in UTC.\n\nExisting bookings inside the window are **not** cancelled. They come back in `meta.conflicting_bookings` so you can deal with them \u2014 silently dropping appointments someone has already been promised is not a decision an API should make.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"starts_at\": \"2026-09-14T07:00:00Z\",\n  \"ends_at\": \"2026-09-18T16:00:00Z\",\n  \"reason\": \"Holiday\"\n}"
            }
          }
        },
        {
          "name": "List time off",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Tenant",
                "value": "{{tenant}}",
                "description": "The workspace. Ignored when a token is sent \u2014 a token carries its own."
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/staff/{{staff_id}}/time-off",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "staff",
                "{{staff_id}}",
                "time-off"
              ]
            },
            "description": "Past and future."
          }
        }
      ]
