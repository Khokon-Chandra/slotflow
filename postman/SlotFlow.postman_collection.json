        {
            "name": "Availability",
            "description": "Free slots, computed at request time from rules \u2212 time off \u2212 existing bookings.",
            "item": [
                {
                    "name": "Find slots",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "X-Tenant",
                                "value": "{{tenant}}",
                                "description": "The workspace. Ignored when a token is sent \u2014 a token carries its own."
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/availability?service_id={{service_id}}&from=2026-09-01&until=2026-09-07&tz={{tz}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "availability"
                            ],
                            "query": [
                                {
                                    "key": "service_id",
                                    "value": "{{service_id}}",
                                    "description": "Required"
                                },
                                {
                                    "key": "from",
                                    "value": "2026-09-01",
                                    "description": "First date, YYYY-MM-DD, in tz"
                                },
                                {
                                    "key": "until",
                                    "value": "2026-09-07",
                                    "description": "Last date, inclusive. Max 31 days."
                                },
                                {
                                    "key": "tz",
                                    "value": "{{tz}}",
                                    "description": "Required. IANA name \u2014 not an offset, not an abbreviation."
                                }
                            ]
                        },
                        "description": "`tz` is required. Every slot carries both the UTC instant and its rendering in that zone, grouped by local date.\n\nRun it again with `tz=Asia/Dhaka`: the instants are identical, the wall clocks are not.",
                        "auth": {
                            "type": "noauth"
                        }
                    }
                },
