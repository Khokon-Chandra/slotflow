    {
      "name": "Availability",
      "description": "Free slots, computed at request time from rules \u2212 time off \u2212 existing bookings.",
      "item": [
        {
          "name": "Find slots",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Tenant",
                "value": "{{tenant}}",
                "description": "The workspace. Ignored when a token is sent \u2014 a token carries its own."
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/availability?service_id={{service_id}}&from=2026-09-01&until=2026-09-07&tz={{tz}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "availability"
              ],
              "query": [
                {
                  "key": "service_id",
                  "value": "{{service_id}}",
                  "description": "Required"
                },
                {
                  "key": "from",
                  "value": "2026-09-01",
                  "description": "First date, YYYY-MM-DD, in tz"
                },
                {
                  "key": "until",
                  "value": "2026-09-07",
                  "description": "Last date, inclusive. Max 31 days."
                },
                {
                  "key": "tz",
                  "value": "{{tz}}",
                  "description": "Required. IANA name \u2014 not an offset, not an abbreviation."
                }
              ]
            },
            "description": "`tz` is required. Every slot carries both the UTC instant and its rendering in that zone, grouped by local date.\n\nRun it again with `tz=Asia/Dhaka`: the instants are identical, the wall clocks are not.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Find slots for one person",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Tenant",
                "value": "{{tenant}}",
                "description": "The workspace. Ignored when a token is sent \u2014 a token carries its own."
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/availability?service_id={{service_id}}&date=2026-09-01&tz={{tz}}&staff_id={{staff_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "availability"
              ],
              "query": [
                {
                  "key": "service_id",
                  "value": "{{service_id}}",
                  "description": ""
                },
                {
                  "key": "date",
                  "value": "2026-09-01",
                  "description": "Shorthand for from = until"
                },
                {
                  "key": "tz",
                  "value": "{{tz}}",
                  "description": ""
                },
                {
                  "key": "staff_id",
                  "value": "{{staff_id}}",
                  "description": ""
                }
              ]
            },
            "description": "Same call, narrowed to one team member.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "description": "Making, reading and changing appointments.",
      "item": [
        {
          "name": "Create a booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Tenant",
                "value": "{{tenant}}",
                "description": "The workspace. Ignored when a token is sent \u2014 a token carries its own."
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/bookings",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings"
              ]
            },
            "description": "**No account required.** Making a customer register before they can make an appointment is the easiest way to lose the appointment.\n\n`starts_at` is an ISO-8601 instant \u2014 paste one straight from an availability response.\n\n**409 `slot_unavailable`** means somebody else took it first. Refresh availability and offer another time; this is a normal outcome, not an error. Send this request twice to see it.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_id\": 1,\n  \"staff_id\": 1,\n  \"starts_at\": \"2026-09-01T07:00:00Z\",\n  \"customer_name\": \"Ada Lovelace\",\n  \"customer_email\": \"ada@example.test\",\n  \"customer_phone\": \"+43 660 1234567\",\n  \"customer_timezone\": \"Europe/Vienna\",\n  \"notes\": \"First visit \\u2014 going a bit shorter than last time.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('booking_reference', pm.response.json().data.reference);",
                  "}",
                  "if (pm.response.code === 409) {",
                  "    console.log('Slot taken \u2014 that is the concurrency guard working. Pick another time.');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Read a booking (as a guest)",
